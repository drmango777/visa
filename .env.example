# Copy this file to .env and fill in what you have. Never commit .env.

# Optional: powers the "Explain it simply" button (English, Spanish, Haitian Creole).
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Optional: shows a Google Map. Without it the app uses an OpenStreetMap map instead.
# In Google Cloud: enable "Maps JavaScript API", then restrict the key to your site's URL.
GOOGLE_MAPS_API_KEY=

# Optional: higher limits when running the data scripts.
CENSUS_API_KEY=
BLS_API_KEY=
